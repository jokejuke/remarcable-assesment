# Safe development values. Copy to .env: `cp .env.example .env`.
# Never use these values in production.
DEBUG=1
SECRET_KEY=django-insecure-local-development-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Comma-separated origins allowed to call /api/ from a browser (no cookies).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT lifetimes in minutes.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_MINUTES=1440

# Cache for the category tree (per-process memory by default).
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=catalog

# Maximum category tree depth, counting the top level.
CATALOG_MAX_CATEGORY_DEPTH=3
