# Production values for docker-compose.prod.yml. Copy to .env.prod and fill in:
#   cp .env.prod.example .env.prod
# Never commit .env.prod.

# Marker that this is the production file; the stack refuses to start without it.
DEPLOY_ENV=prod

# Required. Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(60))'
SECRET_KEY=

# Required. Comma-separated host names served by this site.
ALLOWED_HOSTS=shop.example.com

# Origins (with scheme) trusted for form posts.
CSRF_TRUSTED_ORIGINS=https://shop.example.com

# Browser origins allowed to call /api/ (empty = no cross-origin access).
CORS_ALLOWED_ORIGINS=
